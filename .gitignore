*.py[cod]
*$py.class

# Caches and virtual environments
.venv/
venv/
ENV/
env/
.pytest_cache/
.ipynb_checkpoints/

# Data, raw/split/augmented images, and large feature vectors (không push dataset lên GitHub)
data/*.npy
data/*.npz
data/dataset/
data/raw/
data/augmented/
data/train/*
